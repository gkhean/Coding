import java.util.Scanner;

public class Problem2 {

    // Recursive method
    public static int gcd(int a, int b) {

        // Base Case
        if (b == 0) {
            return a;
        }

        // Recursive Case
        return gcd(b, a % b);
    }

    public static void main(String[] args) {

        Scanner input = new Scanner(System.in);

        System.out.print("Enter first number: ");
        int a = input.nextInt();

        System.out.print("Enter second number: ");
        int b = input.nextInt();

        // Input Validation
        if (a < 0 || b < 0) {
            System.out.println("Negative numbers are not allowed.");
        } else if (a == 0 && b == 0) {
            System.out.println("GCD is undefined for 0 and 0.");
        } else {
            int result = gcd(a, b);
            System.out.println("GCD: " + result);
        }

        input.close();
    }
}


import java.util.Scanner;

public class Problem3 {

    // Method 1: Calculate Array Sum
    public static int arraySum(int[] values, int index) {

        // Base Case
        if (index == values.length) {
            return 0;
        }

        // Recursive Case
        return values[index] + arraySum(values, index + 1);
    }

    // Method 2: Find Maximum Element
    public static int findMaximum(int[] values, int index) {

        // Base Case
        if (index == values.length - 1) {
            return values[index];
        }

        // Recursive Case
        int maximum = findMaximum(values, index + 1);

        if (values[index] > maximum) {
            return values[index];
        } else {
            return maximum;
        }
    }

    // Method 3: Count Even Elements
    public static int countEven(int[] values, int index) {

        // Base Case
        if (index == values.length) {
            return 0;
        }

        // Recursive Case
        if (values[index] % 2 == 0) {
            return 1 + countEven(values, index + 1);
        } else {
            return countEven(values, index + 1);
        }
    }

    public static void main(String[] args) {

        Scanner input = new Scanner(System.in);

        System.out.print("Enter the number of elements: ");
        int size = input.nextInt();

        if (size <= 0) {
            System.out.println("Array must contain at least one element.");
        } else {

            int[] values = new int[size];

            // Read array elements
            for (int i = 0; i < size; i++) {
                System.out.print("Enter element " + (i + 1) + ": ");
                values[i] = input.nextInt();
            }

            // Call recursive methods
            int sum = arraySum(values, 0);
            int maximum = findMaximum(values, 0);
            int evenCount = countEven(values, 0);

            // Display results
            System.out.println("\nArray Sum: " + sum);
            System.out.println("Largest Element: " + maximum);
            System.out.println("Number of Even Elements: " + evenCount);
        }

        input.close();
    }
}
